<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>SimplyWorks.PdfTemplarClient</PackageId>
    <Authors>Simplify9</Authors>
    <Product>SimplyWorks.PdfTemplar.Client</Product>
    <Description>A .NET client SDK for PdfTemplar service that generates PDF documents from templates and data objects. Supports configurable JSON naming strategies and comprehensive error handling. See GitHub repository for full documentation and usage examples.</Description>
    <PackageTags>pdf;template;generator;document;client;sdk</PackageTags>
    <PackageProjectUrl>https://github.com/simplify9/SW-PdfTemplar-Client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/simplify9/SW-PdfTemplar-Client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Simplify9</Copyright>
    <Company>Simplify9</Company>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="System.Text.Encoding" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="../README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
</Project>
